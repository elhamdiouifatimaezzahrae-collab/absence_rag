# Copier ce fichier en .env et adapter les valeurs (fait automatiquement par
# scripts/codespaces/installer.sh et scripts/windows/installer.ps1, port ajusté :
# 5432 dans Codespaces, 5433 avec le docker-compose.yml de Windows).
# Valeurs de TEST uniquement : mots de passe publics, jamais en production.
# Les variables d'environnement du système ont priorité sur ce fichier.

# Usage déclaré par le déploiement : TEST ou EXPLOITATION.
# L'application refuse de démarrer s'il diffère de l'usage enregistré en base (T94).
AGENT_TAG_USAGE=TEST

# Connexion applicative (rôle sans droit de créer ou modifier le schéma).
AGENT_TAG_DATABASE_URL=postgresql://agent_tag_app:app_test@localhost:5433/agent_tag_test

# Connexion propriétaire, utilisée uniquement pour les migrations et l'initialisation.
AGENT_TAG_OWNER_URL=postgresql://agent_tag_owner:owner_test@localhost:5433/agent_tag_test

# Dossier d'archivage des fichiers importés (copie intacte, nommée par empreinte SHA-256).
AGENT_TAG_ARCHIVES=archives
